---
import { getCollection } from "astro:content";
import Section from "./Section.astro";
import SectionEyebrow from "./SectionEyebrow.astro";
import Icon from "./Icon.astro";

// Personal projects — bordered 2×2 grid (same treatment as the companies wall).
// Whole card is a stretched link to the live URL (or repo); a separate GitHub icon
// links to the repo when there's also a live site.
const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .slice(0, 4);
---

<Section class="pt-24 pb-8">
  <SectionEyebrow>Personal Projects</SectionEyebrow>

  {/* Full-bleed to the rails (-mx-6); gap-px over bg-border draws the internal hairlines. */}
  <div
    class="-mx-6 mt-8 grid grid-cols-1 gap-px border-y border-border bg-border md:grid-cols-2"
  >
    {
      projects.map((p) => {
        const { name, summary, stack, url, repo, status } = p.data;
        const primary = url ?? repo; // whole-card (stretched) link target
        const showRepoIcon = Boolean(url && repo); // repo shown as a separate GitHub link
        return (
          <div class="group relative flex min-h-[220px] flex-col bg-muted p-8 transition-colors hover:bg-background md:p-10">
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-serif text-2xl font-medium tracking-[-0.01em] transition-colors duration-200 group-hover:text-orange-600 dark:group-hover:text-amber-800 md:text-3xl">
                {primary ? (
                  <a
                    href={primary}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="after:absolute after:inset-0"
                  >
                    {name}
                  </a>
                ) : (
                  name
                )}
              </h3>
              <div class="flex shrink-0 items-center gap-3 text-muted-foreground">
                {showRepoIcon && (
                  <a
                    href={repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${name} on GitHub`}
                    class="relative z-10 transition-colors hover:text-foreground"
                  >
                    <Icon name="github" />
                  </a>
                )}
                {primary && (
                  <span class="font-mono text-lg transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
                    ↗
                  </span>
                )}
              </div>
            </div>

            {status && (
              <span class="mt-3 inline-flex w-fit items-center gap-2 font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">
                <span class="h-1.5 w-1.5 rounded-full bg-primary" />
                {status}
              </span>
            )}

            <p class="mt-4 max-w-[48ch] text-base leading-[1.6] text-muted-foreground">
              {summary}
            </p>

            <ul class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-8 font-mono text-xs uppercase tracking-[0.06em] text-muted-foreground">
              {stack.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>

  <p
    class="mt-12 text-center font-mono text-xs uppercase tracking-[0.1em] text-muted-foreground md:mt-16"
  >
    And more…
  </p>
</Section>
