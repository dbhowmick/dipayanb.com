---
import Section from "./Section.astro";
// Pedigree row — caliber of companies + role, read left→right as an 18-year timeline.
// <!-- TODO: review copy -->
const stats = [
    { metric: "Employee #2", label: "Acceldata" },
    { metric: "Site lead, India", label: "Altimate AI" },
    { metric: "Apache committer", label: "Ambari" },
    { metric: "Early engineer", label: "Hortonworks (Bangalore)" },
];
---

<Section class="py-8">
    <dl
        class="reveal grid grid-cols-1 divide-y divide-border md:grid-cols-4 md:divide-x md:divide-y-0"
    >
        {
            stats.map((stat) => (
                <div class="flex flex-col gap-1 py-3 md:px-6 md:py-0 md:first:pl-0">
                    <dt class="font-mono text-sm text-foreground">
                        {stat.metric}
                    </dt>
                    <dd class="font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">
                        {stat.label}
                    </dd>
                </div>
            ))
        }
    </dl>
</Section>
