---
const year = new Date().getFullYear();

const links = [
  { label: "Email", href: "mailto:me@dipayanb.com" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/dipayanb" },
  { label: "GitHub", href: "https://github.com/dipayanb" },
];
---

<footer class="w-full border-t border-border">
  <div
    class="mx-auto flex w-full max-w-[1280px] flex-col gap-4 border-x border-border px-6 py-10 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">
      © {year} Dipayan Bhowmick
    </p>
    <nav class="flex items-center gap-5">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
