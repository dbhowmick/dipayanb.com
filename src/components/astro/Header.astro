---
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/work" },
  { label: "Writing", href: "/writing" },
  { label: "About", href: "/about" },
  { label: "Resume", href: "/resume" },
];
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background">
  <div class="mx-auto flex h-16 w-full max-w-[1280px] items-center justify-between px-6">
    <a
      href="/"
      class="font-serif text-xl font-medium tracking-[-0.01em] transition-colors hover:text-primary sm:text-2xl"
    >
      Dipayan Bhowmick
    </a>

    <nav class="flex items-center gap-1">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
          >
            {item.label}
          </a>
        ))
      }
      <span class="ml-1"><ThemeToggle /></span>
    </nav>
  </div>
</header>
