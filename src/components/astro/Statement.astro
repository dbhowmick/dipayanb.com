---
import Section from "./Section.astro";
// Centered "statement" moment — the signature default.com rhythm. Big air around it.
// <!-- TODO: review copy -->
---

<Section class="py-28 text-center md:py-40">
  <div class="reveal">
    <h2
      class="mx-auto max-w-[20ch] font-serif text-3xl font-medium leading-[1.15] tracking-[-0.015em] md:text-5xl"
    >
      Most products stall where the systems meet the people.
    </h2>
    <p class="mx-auto mt-6 max-w-[560px] text-base leading-[1.6] text-muted-foreground md:text-lg">
      I work at that seam — designing the infrastructure and building the teams that
      turn a hard technical idea into something people rely on.
    </p>
  </div>
</Section>
