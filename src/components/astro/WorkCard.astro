---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { name, summary, stack, year } = project.data;
---

<a
  href={`/work#${project.id}`}
  class="group flex flex-col rounded-xl border border-border bg-card p-7 transition-colors hover:border-foreground/25"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-serif text-xl font-medium tracking-[-0.01em]">{name}</h3>
    <span class="font-mono text-xs text-muted-foreground">{year}</span>
  </div>
  <p class="mt-2 text-sm leading-[1.6] text-muted-foreground">{summary}</p>
  <ul class="mt-4 flex flex-wrap gap-2">
    {
      stack.map((tech) => (
        <li class="font-mono text-xs uppercase tracking-[0.06em] text-muted-foreground">
          {tech}
        </li>
      ))
    }
  </ul>
</a>
