---
// Shared scroll-in reveal. Elements with `.reveal` start hidden (CSS, gated by
// `.js` + prefers-reduced-motion in app.css) and get `.is-visible` when they enter
// the viewport, with a small per-group stagger. Reused on /work and /writing later.
---

<script>
  const els = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));

  if (!("IntersectionObserver" in window)) {
    // No observer support: just show everything.
    els.forEach((el) => el.classList.add("is-visible"));
  } else {
    const io = new IntersectionObserver(
      (entries, observer) => {
        // Stagger reveals within a batch entering together (~60ms apart).
        let i = 0;
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.style.transitionDelay = `${i * 60}ms`;
          el.classList.add("is-visible");
          observer.unobserve(el);
          i++;
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
