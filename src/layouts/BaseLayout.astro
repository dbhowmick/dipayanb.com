---
// Fontsource (self-hosted, variable). Imported here so Vite bundles & fingerprints them.
import "@fontsource-variable/geist";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/geist-mono";
import "../styles/app.css";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dipayan Bhowmick",
  description = "Dipayan Bhowmick — engineer and builder. 18 years across data infrastructure, developer tools, and AI.",
} = Astro.props;

// Umami analytics. Emitted only in production builds (so local dev traffic is not
// counted) and only when a website id is configured. Set PUBLIC_UMAMI_WEBSITE_ID in
// the build env; override PUBLIC_UMAMI_SRC if your Umami instance uses a different host.
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiSrc =
  import.meta.env.PUBLIC_UMAMI_SRC ?? "https://cloud.umami.is/script.js";
const enableAnalytics = import.meta.env.PROD && Boolean(umamiWebsiteId);
---

<!doctype html>
<html lang="en">
  <head>
    {/* Pre-paint theme: apply `.dark` before first paint to avoid FOUC.
        Reads localStorage, falls back to OS preference. Toggle UI lands in Phase 1. */}
    <script is:inline>
      (function () {
        // Mark JS-enabled so scroll-in reveal styles only hide content when JS can show it.
        document.documentElement.classList.add("js");
        try {
          // Dark-first: default to dark on first visit (no stored choice).
          const stored = localStorage.getItem("theme");
          const dark = stored ? stored === "dark" : true;
          document.documentElement.classList.toggle("dark", dark);
        } catch (_) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {/* Privacy-friendly analytics (Umami). Production builds only; see frontmatter. */}
    {
      enableAnalytics && (
        <script is:inline defer src={umamiSrc} data-website-id={umamiWebsiteId} />
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col bg-background text-foreground font-sans antialiased">
    {/* Full-width chrome: header/section bottom rules span the viewport; vertical rails
        live inside each section's centered container (see Section.astro). */}
    <Header />
    <main class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
