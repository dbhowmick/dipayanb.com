---
// Fontsource (self-hosted, variable). Imported here so Vite bundles & fingerprints them.
import "@fontsource-variable/geist";
import "@fontsource-variable/fraunces";
import "@fontsource-variable/geist-mono";
import "../styles/app.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dipayan Bhowmick",
  description = "Dipayan Bhowmick — engineer and builder. 18 years across data infrastructure, developer tools, and AI.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    {/* Pre-paint theme: apply `.dark` before first paint to avoid FOUC.
        Reads localStorage, falls back to OS preference. Toggle UI lands in Phase 1. */}
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch (_) {}
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-dvh bg-background text-foreground font-sans antialiased">
    <slot />
  </body>
</html>
