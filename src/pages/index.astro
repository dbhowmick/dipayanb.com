---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/astro/Hero.astro";
import StatsBar from "../components/astro/StatsBar.astro";
import Statement from "../components/astro/Statement.astro";
import Section from "../components/astro/Section.astro";
import SectionEyebrow from "../components/astro/SectionEyebrow.astro";
import ProjectGrid from "../components/astro/ProjectGrid.astro";
import WritingList from "../components/astro/WritingList.astro";
import RevealScript from "../components/astro/RevealScript.astro";

const featuredProjects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const latestPosts = (await getCollection("posts"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout>
  <Hero />

  <StatsBar />

  <Statement />

  <Section class="py-24 md:py-40">
    <SectionEyebrow>Selected Work</SectionEyebrow>
    <div class="mt-10">
      <ProjectGrid projects={featuredProjects} />
    </div>
  </Section>

  <Section class="py-24 md:py-40">
    <SectionEyebrow>Recent Writing</SectionEyebrow>
    <div class="mt-10">
      <WritingList posts={latestPosts} />
    </div>
  </Section>

  {/* Closing CTA — no bottom rule; the footer's full-width top border provides that line. */}
  <Section bottom={false} class="py-28 text-center md:py-40">
    <div class="reveal">
      <h2 class="mx-auto max-w-[16ch] font-serif text-4xl font-medium tracking-[-0.02em] md:text-6xl">
        Let's build something durable.
      </h2>
      <p class="mx-auto mt-5 max-w-[480px] text-base leading-[1.6] text-muted-foreground md:text-lg">
        Open to founder conversations, advisory, and the occasional good problem.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Get in touch
      </a>
    </div>
  </Section>

  <RevealScript />
</BaseLayout>
