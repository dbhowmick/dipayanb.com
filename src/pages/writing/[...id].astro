---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/astro/Section.astro";
import RevealScript from "../../components/astro/RevealScript.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, series } = post.data;

// Sibling posts in the same series (if any), ordered by part — drives the
// series nav so every part links to the others.
const seriesPosts = series
  ? (await getCollection("posts"))
      .filter((p) => !p.data.draft && p.data.series === series)
      .sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0))
  : [];

const formatLong = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });

// Reading time from the prose body (~200 wpm). Strip fenced code blocks and
// raw HTML (e.g. the <video> figure) first so code-heavy posts aren't inflated.
const prose = (post.body ?? "")
  .replace(/```[\s\S]*?```/g, "")
  .replace(/<[^>]+>/g, " ");
const words = prose.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));
---

<BaseLayout
  title={`${title} · Dipayan Bhowmick`}
  description={description}
  type="article"
>
  {/* Single 680px prose column; the footer's top border closes the page. */}
  <Section bottom={false} class="py-20 md:py-28">
    <article class="mx-auto max-w-[680px]">
      <header>
        <p
          class="reveal flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground"
        >
          <time datetime={pubDate.toISOString()}>{formatLong(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
        </p>
        <h1
          class="reveal mt-5 text-balance font-serif text-4xl font-medium leading-[1.1] tracking-[-0.02em] md:text-5xl"
        >
          {title}
        </h1>
        <p class="reveal mt-5 text-lg leading-[1.6] text-muted-foreground">
          {description}
        </p>
        {
          tags.length > 0 && (
            <ul class="reveal mt-6 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="rounded-md border border-border px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.08em] text-muted-foreground">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
      </header>

      {/* Long-form body. prose plugin + site-voice modifiers (Fraunces headings,
          orange links). Body font inherits Geist from <body>. */}
      <div
        class="reveal mt-12 max-w-none prose prose-neutral dark:prose-invert [--tw-prose-body:var(--muted-foreground)] dark:[--tw-prose-invert-body:var(--muted-foreground)] prose-headings:font-serif prose-headings:font-medium prose-headings:tracking-[-0.01em] prose-a:font-normal prose-a:text-orange-600 prose-a:underline-offset-2 dark:prose-a:text-orange-500"
      >
        <Content />
      </div>

      {
        updatedDate && (
          <p class="mt-12 font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">
            Updated {formatLong(updatedDate)}
          </p>
        )
      }

      {
        seriesPosts.length > 1 && (
          <nav
            aria-label={`${series} series`}
            class="mt-16 border-t border-border pt-8"
          >
            <p class="font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">
              {series}
            </p>
            <ol class="mt-4 space-y-2.5">
              {seriesPosts.map((p) => (
                <li class="flex gap-3 leading-snug">
                  <span class="shrink-0 font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">
                    Part {p.data.part}
                  </span>
                  {p.id === post.id ? (
                    <span aria-current="true" class="text-foreground">
                      {p.data.title}
                    </span>
                  ) : (
                    <a
                      href={`/writing/${p.id}`}
                      class="text-orange-600 underline-offset-2 hover:underline dark:text-orange-500"
                    >
                      {p.data.title}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <footer class="mt-16 border-t border-border pt-8">
        <a
          href="/writing"
          class="font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground transition-colors hover:text-foreground"
        >
          ← All writing
        </a>
      </footer>
    </article>
  </Section>

  <RevealScript />
</BaseLayout>
