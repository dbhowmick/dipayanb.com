# --- Build-time / install ---
# GitHub PAT with read:packages, used by CI (Cloudflare build env) to fetch @meldui/* packages.
# Locally this is configured in your user-level ~/.npmrc instead.
NPM_TOKEN=

# --- Public (exposed to the client; Astro PUBLIC_* convention) ---
# Cloudflare Turnstile SITE key. If unset, the widget falls back to Cloudflare's
# always-pass test key, so local dev works without it. Set the real key in the
# production build environment.
PUBLIC_TURNSTILE_SITE_KEY=

# Umami analytics website id (from your Umami dashboard). The tracking script is only
# emitted in PRODUCTION builds, so set this in the production build env. Leaving it
# blank disables analytics entirely (incl. local dev).
PUBLIC_UMAMI_WEBSITE_ID=
# Optional: override only if your Umami dashboard shows a different script host
# (e.g. https://eu.umami.is/script.js). Defaults to https://cloud.umami.is/script.js.
# PUBLIC_UMAMI_SRC=

# --- Server secrets (set via `wrangler secret put` in production) — Phase 4/8 ---
# For local dev these go in .dev.vars (not .env). See .dev.vars.example.
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=
# OWNER_EMAIL=
